# Base URL of the Trilux backend. Inlined into the client bundle at BUILD time,
# so it must be reachable from the browser (not a docker-internal hostname).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: enable a Next.js rewrite proxying /api/* to <dest>/api/* (next.config.mjs).
# Leave unset to have the app call the backend directly.
# API_PROXY_DESTINATION=http://localhost:8000

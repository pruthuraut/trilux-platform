DATABASE_URL=
REDIS_URL=127.0.0.1:6379
JWT_SECRET=
SMTP_FROM=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash
LLM_API_URL=
LLM_MODEL_NAME=

# Recon AI layer — pluggable provider. RECON_AI_PROVIDER selects the primary;
# the others act as fallbacks if configured.
#   bedrock | openrouter | anthropic | gemini
# Default 'bedrock' uses your AWS chain + AWS_REGION (no API key). For Docker you
# must pass AWS creds into the container (see docker-compose AWS_* passthrough).
RECON_AI_PROVIDER=bedrock
# openrouter (API key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
# anthropic (API key)
ANTHROPIC_API_KEY=
ANTHROPIC_RECON_MODEL=claude-opus-4-8
# bedrock (no key — uses your AWS chain + AWS_REGION, like Claude Code's Bedrock setup)
BEDROCK_RECON_MODEL=us.anthropic.claude-opus-4-8
# AWS_REGION=us-west-2
RECON_AI_MAX_TOKENS=4096

# Recon storage + tooling
RECON_BUCKET=recon-results
MOBSF_URL=http://localhost:8000
MOBSF_API_KEY=
# Optional explicit tool paths, e.g. TOOL_NUCLEI=/usr/local/bin/nuclei

# --- Recon execution sandbox ---
# local  = run tools as subprocesses on the worker (dev / trusted host)
# docker = run each tool in an ephemeral, hardened, --rm container (recommended)
RECON_EXECUTION_BACKEND=docker
RECON_TOOLBOX_IMAGE=trilux-toolbox:latest
RECON_SCAN_NETWORK=trilux_scan_net
RECON_WORK_DIR=/recon-work
# Container resource caps for each spawned tool
RECON_CONTAINER_MEM=1g
RECON_CONTAINER_CPUS=1.0
RECON_CONTAINER_PIDS=512